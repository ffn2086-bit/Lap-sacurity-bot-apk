<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- outer bevel -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:endColor="#5A5D63" />
        </shape>
    </item>
    <!-- brushed silver face -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:startColor="#E5E7EB"
                android:centerColor="#C0C0C0"
                android:endColor="#8A8D93" />
        </shape>
    </item>
</layer-list>
